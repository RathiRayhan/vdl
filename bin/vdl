#!/usr/bin/env bash
# shellcheck shell=bash
# vdl - portable smart downloader for Linux (yt-dlp + aria2c)
#
# Requires: bash 4+, yt-dlp.
# Optional: aria2c, ffmpeg, curl_cffi (browser impersonation),
#           wl-paste / xclip / xsel (clipboard), xdg-user-dir.
#
# Direct files (.zip, .iso, .pdf, .mp4 links, ...) go to aria2c when it is
# available; pages, playlists and streams go to yt-dlp. All yt-dlp defaults
# live in this file, so vdl does not depend on ~/.config/yt-dlp/config.

set -u -o pipefail

readonly VDL_VERSION="2.0.0"

if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
    C_RED=$'\033[1;31m'
    C_GRN=$'\033[1;32m'
    C_YEL=$'\033[1;33m'
    C_CYN=$'\033[1;36m'
    C_DIM=$'\033[2m'
    C_OFF=$'\033[0m'
else
    C_RED='' C_GRN='' C_YEL='' C_CYN='' C_DIM='' C_OFF=''
fi

warn() { printf '%s[!] %s%s\n' "$C_YEL" "$*" "$C_OFF" >&2; }
err()  { printf '%s[!] %s%s\n' "$C_RED" "$*" "$C_OFF" >&2; }
note() { printf '%s[::] %s%s\n' "$C_DIM" "$*" "$C_OFF" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
vdl - smart downloader for Linux (yt-dlp + aria2c)

Usage:
  vdl [options] <url> | <links.txt>
  vdl [options]                    # no URL: takes the link from the clipboard

Options:
  -b, --browser NAME       Browser to take cookies from (default: auto-detect)
                           vivaldi firefox brave chromium chrome edge opera
                           safari whale none    (NAME:PROFILE also works)
  -n, --no-cookies         Do not read browser cookies
  -q, --quality HEIGHT     Max video height (default: 1080; 2k=1440, 4k=2160)
  -a, --audio              Audio only, converted to MP3 320k
  -i, --batch-file FILE    Read URLs from FILE (repeatable)
      --no-aria            Do not use aria2c (direct files go to yt-dlp too)
      --no-impersonate     Disable browser TLS impersonation
      --download-dir DIR   Override save directory for this run
      --dry-run            Show what would be done, then exit
      --quiet              Suppress banner and progress output
      --aria-opts OPTS     Extra options for aria2c
      --max-speed RATE     Overall download speed limit (e.g. 1M, 500K)
      --limit-speed RATE   Per-connection speed limit
      --referer URL        Send this Referer header
      --user-agent UA      Send this User-Agent header
      --proxy URL          Route downloads through this proxy
  -h, --help               Show this help
  -V, --version            Show version

Any other option is passed straight through to yt-dlp. Flags that take a
value can always be written as --flag=value; that form is never mistaken
for a URL or a batch file.

Environment:
  VDL_SAVE_DIR        Download directory (default: XDG download dir + /vdl)
  VDL_BROWSER         Default browser, overridden by -b
  VDL_QUALITY         Default max height, overridden by -q
  VDL_TMP_KEEP_DAYS   Days to keep interrupted leftovers (default: 7)
  VDL_IMPERSONATE     auto | off | <target> (default: auto = chrome)
  VDL_CONFIG          Extra yt-dlp config file
                      (default: ~/.config/vdl/yt-dlp.conf)
  VDL_CONFIG_DIR      Directory for vdl's own config file
                      (default: ~/.config/vdl)
  NO_COLOR            Disable colored output

A vdl-specific config file ($VDL_CONFIG_DIR/config) provides KEY=VALUE
defaults mirroring the VDL_* variables.  Command-line flags and exported
environment variables take precedence over both.

Examples:
  vdl                                     # URL from clipboard
  vdl links.txt                           # every URL listed in links.txt
  vdl -q 720 links.txt
  vdl -a "https://example.com/album"
  vdl -n "https://example.com/file.iso"
  vdl --no-aria -F "https://example.com/video"
  vdl --dry-run "https://example.com/file.iso"
  vdl --download-dir ~/tmp "https://example.com/file.zip"
  vdl magnet:?xt=urn:btih:abc123
EOF
}

need_value() {
    err "Option $1 requires a value"
    exit 2
}

detect_browser() {
    local name dir
    while IFS='|' read -r name dir; do
        if [[ -d $dir ]]; then
            printf '%s\n' "$name"
            return 0
        fi
    done <<EOF
vivaldi|$HOME/.config/vivaldi
firefox|$HOME/.mozilla/firefox
brave|$HOME/.config/BraveSoftware/Brave-Browser
chromium|$HOME/.config/chromium
chrome|$HOME/.config/google-chrome
edge|$HOME/.config/microsoft-edge
opera|$HOME/.config/opera
EOF
    printf 'none\n'
}

read_clipboard() {
    local out='' line=''

    if [[ -n ${WAYLAND_DISPLAY:-} ]] && have wl-paste; then
        out=$(wl-paste -n 2>/dev/null) || out=''
    elif [[ -n ${DISPLAY:-} ]] && have xclip; then
        out=$(xclip -o -selection clipboard 2>/dev/null) || out=''
    elif [[ -n ${DISPLAY:-} ]] && have xsel; then
        out=$(xsel --clipboard --output 2>/dev/null) || out=''
    elif have wl-paste; then
        out=$(wl-paste -n 2>/dev/null) || out=''
    fi

    [[ -n $out ]] || return 1

    IFS= read -r line <<< "$out" || true
    line=${line%$'\r'}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    printf '%s\n' "$line"
}

normalize_quality() {
    local q=${1,,}
    q=${q%p}
    case $q in
        2k)   q=1440 ;;
        4k)   q=2160 ;;
        8k)   q=4320 ;;
    esac
    [[ $q =~ ^[1-9][0-9]*$ ]] || return 1
    printf '%s\n' "$q"
}

# yt-dlp's own capability list is authoritative: curl_cffi may be importable
# and still unusable (wrong version, different Python, missing libcurl). The
# table marks unavailable targets with "(unavailable)" and target names are
# listed in the first column.
imp_target_available() {
    local list=${1:-} target=${2:-}
    [[ -n $list && -n $target ]] || return 1
    printf '%s\n' "$list" | awk -v t="$target" '
        tolower($1) == tolower(t) && $0 !~ /\(unavailable\)/ { found = 1 }
        END { exit !found }
    '
}

# Normalize a speed string like "1M", "500K", "1.5M" into aria2c's format.
# Returns the string lowercased with a trailing unit; validates the numeric part.
normalize_speed() {
    local s=${1,,}
    s=${s// /}
    # Accept digits optionally followed by K, M, G (case-insensitive, already lowercased).
    [[ $s =~ ^[0-9]+([.][0-9]+)?(k|m|g)?$ ]] || return 1
    printf '%s\n' "$s"
}

# Read the vdl-specific config file ($XDG_CONFIG_HOME/vdl/config or
# ~/.config/vdl/config).  It is a simple KEY=VALUE file; lines starting with #
# are comments.  Environment variables and CLI flags take precedence, so this
# function only sets defaults that haven't already been provided.
read_vdl_config() {
    local conf="${VDL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vdl/config}"
    [[ -f $conf ]] || return 0

    local key val
    while IFS='=' read -r key val || [[ -n $key ]]; do
        # strip CR and surrounding whitespace
        key=${key%$'\r'}
        key=${key#"${key%%[![:space:]]*}"}
        key=${key%"${key##*[![:space:]]}"}
        val=${val%$'\r'}
        val=${val#"${val%%[![:space:]]*}"}
        val=${val%"${val##*[![:space:]]}"}
        # skip comments and blank lines
        [[ -z $key || $key == \#* ]] && continue

        case $key in
            BROWSER)      [[ -z ${VDL_BROWSER:-} ]] && export VDL_BROWSER=$val ;;
            QUALITY)      [[ -z ${VDL_QUALITY:-} ]] && export VDL_QUALITY=$val ;;
            SAVE_DIR)     [[ -z ${VDL_SAVE_DIR:-} ]] && export VDL_SAVE_DIR=$val ;;
            IMPERSONATE)  [[ -z ${VDL_IMPERSONATE:-} ]] && export VDL_IMPERSONATE=$val ;;
            TMP_KEEP_DAYS) [[ -z ${VDL_TMP_KEEP_DAYS:-} ]] && export VDL_TMP_KEEP_DAYS=$val ;;
            CONFIG)       [[ -z ${VDL_CONFIG:-} ]] && export VDL_CONFIG=$val ;;
        esac
    done < "$conf"
}

# ---------------------------------------------------------------------------
# 1. Parse arguments
# ---------------------------------------------------------------------------
browser_arg=''
browser_set=0
no_cookies=0
quality_arg=''
quality_set=0
audio=0
no_aria=0
no_impersonate=0
referer=''
ua=''
proxy=''
download_dir=''
quiet=0
dry_run=0
aria_opts=''
max_speed=''
limit_speed=''

declare -a batch_files=()
declare -a url_args=()
declare -a url_prev=()
declare -a passthru=()
prev_unknown_flag=0

while (( $# > 0 )); do
    arg=$1
    shift
    case $arg in
        -h|--help)
            usage
            exit 0
            ;;
        -V|--version)
            printf 'vdl %s\n' "$VDL_VERSION"
            exit 0
            ;;
        -n|--no-cookies)
            no_cookies=1
            prev_unknown_flag=0
            ;;
        -a|--audio)
            audio=1
            prev_unknown_flag=0
            ;;
        --no-aria)
            no_aria=1
            prev_unknown_flag=0
            ;;
        --no-impersonate)
            no_impersonate=1
            prev_unknown_flag=0
            ;;
        -b|--browser)
            (( $# > 0 )) || need_value "$arg"
            browser_arg=$1
            shift
            browser_set=1
            prev_unknown_flag=0
            ;;
        --browser=*)
            browser_arg=${arg#*=}
            browser_set=1
            prev_unknown_flag=0
            ;;
        -b?*)
            browser_arg=${arg#-b}
            browser_set=1
            prev_unknown_flag=0
            ;;
        -q|--quality)
            (( $# > 0 )) || need_value "$arg"
            quality_arg=$1
            shift
            quality_set=1
            prev_unknown_flag=0
            ;;
        --quality=*)
            quality_arg=${arg#*=}
            quality_set=1
            prev_unknown_flag=0
            ;;
        -q?*)
            quality_arg=${arg#-q}
            quality_set=1
            prev_unknown_flag=0
            ;;
        -i|--batch-file)
            (( $# > 0 )) || need_value "$arg"
            batch_files+=("$1")
            shift
            prev_unknown_flag=0
            ;;
        --batch-file=*)
            batch_files+=("${arg#*=}")
            prev_unknown_flag=0
            ;;
        -i?*)
            batch_files+=("${arg#-i}")
            prev_unknown_flag=0
            ;;
        --referer)
            (( $# > 0 )) || need_value "$arg"
            referer=$1
            shift
            prev_unknown_flag=0
            ;;
        --referer=*)
            referer=${arg#*=}
            prev_unknown_flag=0
            ;;
        --user-agent)
            (( $# > 0 )) || need_value "$arg"
            ua=$1
            shift
            prev_unknown_flag=0
            ;;
        --user-agent=*)
            ua=${arg#*=}
            prev_unknown_flag=0
            ;;
        --proxy)
            (( $# > 0 )) || need_value "$arg"
            proxy=$1
            shift
            prev_unknown_flag=0
            ;;
        --proxy=*)
            proxy=${arg#*=}
            prev_unknown_flag=0
            ;;
        --download-dir)
            (( $# > 0 )) || need_value "$arg"
            download_dir=$1
            shift
            prev_unknown_flag=0
            ;;
        --download-dir=*)
            download_dir=${arg#*=}
            prev_unknown_flag=0
            ;;
        --dry-run)
            dry_run=1
            prev_unknown_flag=0
            ;;
        --quiet)
            quiet=1
            prev_unknown_flag=0
            ;;
        --aria-opts)
            (( $# > 0 )) || need_value "$arg"
            aria_opts=$1
            shift
            prev_unknown_flag=0
            ;;
        --aria-opts=*)
            aria_opts=${arg#*=}
            prev_unknown_flag=0
            ;;
        --max-speed)
            (( $# > 0 )) || need_value "$arg"
            max_speed=$1
            shift
            prev_unknown_flag=0
            ;;
        --max-speed=*)
            max_speed=${arg#*=}
            prev_unknown_flag=0
            ;;
        --limit-speed)
            (( $# > 0 )) || need_value "$arg"
            limit_speed=$1
            shift
            prev_unknown_flag=0
            ;;
        --limit-speed=*)
            limit_speed=${arg#*=}
            prev_unknown_flag=0
            ;;
        --)
            while (( $# > 0 )); do
                url_args+=("$1")
                url_prev+=(0)
                shift
            done
            ;;
        -*)
            passthru+=("$arg")
            prev_unknown_flag=1
            ;;
        *)
            url_args+=("$arg")
            url_prev+=("$prev_unknown_flag")
            prev_unknown_flag=0
            ;;
    esac
done

# ---------------------------------------------------------------------------
# 2. Resolve browser, quality and mode
# ---------------------------------------------------------------------------
read_vdl_config

if (( no_cookies )); then
    browser=none
elif (( browser_set )); then
    browser=$browser_arg
elif [[ -n ${VDL_BROWSER:-} ]]; then
    browser=$VDL_BROWSER
else
    browser=$(detect_browser)
fi

if [[ $browser == *:* ]]; then
    bname=${browser%%:*}
    bprof=${browser#*:}
    browser="${bname,,}:$bprof"
else
    browser=${browser,,}
fi

if [[ $browser != none ]]; then
    case ${browser%%:*} in
        vivaldi|firefox|brave|chromium|chrome|edge|opera|safari|whale) ;;
        *)
            err "Unknown browser: $browser"
            printf '    Supported: vivaldi firefox brave chromium chrome edge opera safari whale none\n' >&2
            exit 2
            ;;
    esac
fi

if (( quality_set )); then
    quality_raw=$quality_arg
elif [[ -n ${VDL_QUALITY:-} ]]; then
    quality_raw=$VDL_QUALITY
else
    quality_raw=1080
fi
if ! quality=$(normalize_quality "$quality_raw"); then
    err "Invalid quality: $quality_raw (try 720, 1080, 2k, 4k)"
    exit 2
fi

# ---------------------------------------------------------------------------
# 3. Collect URLs, batch files and passthrough arguments
# ---------------------------------------------------------------------------
urls=()

if (( ${#url_args[@]} )); then
    for i in "${!url_args[@]}"; do
        arg=${url_args[$i]}
        case $arg in
            http://*|https://*)
                urls+=("$arg")
                ;;
            www.*)
                urls+=("https://$arg")
                ;;
            magnet:*)
                urls+=("$arg")
                ;;
            *.txt)
                # A bare .txt is a batch file unless it is the value of an
                # unknown flag (e.g. --download-archive archive.txt).
                if [[ -f $arg && ${url_prev[$i]} -eq 0 ]]; then
                    batch_files+=("$arg")
                else
                    passthru+=("$arg")
                fi
                ;;
            *)
                passthru+=("$arg")
                ;;
        esac
    done
fi

if (( ${#batch_files[@]} )); then
    for f in "${batch_files[@]}"; do
        if [[ ! -f $f ]]; then
            warn "Batch file not found: $f"
            continue
        fi
        while IFS= read -r line || [[ -n $line ]]; do
            line=${line%$'\r'}
            line=${line#"${line%%[![:space:]]*}"}
            line=${line%"${line##*[![:space:]]}"}
            if [[ $line =~ ^https?:// ]]; then
                urls+=("$line")
            fi
        done < "$f"
    done
fi

if (( ${#urls[@]} == 0 )); then
    if clip=$(read_clipboard) && [[ $clip =~ ^https?:// ]]; then
        urls+=("$clip")
        note "Auto-grabbed URL from clipboard"
    else
        err "No valid URL, batch file, or clipboard link found."
        printf '    Run vdl --help for usage.\n' >&2
        exit 1
    fi
fi

# Remove duplicates while preserving order.
declare -A seen=()
declare -a uniq_urls=()
for u in "${urls[@]}"; do
    [[ -n ${seen[$u]:-} ]] && continue
    seen[$u]=1
    uniq_urls+=("$u")
done
urls=("${uniq_urls[@]}")

# ---------------------------------------------------------------------------
# 4. Paths and dependencies
# ---------------------------------------------------------------------------
if [[ -n $download_dir ]]; then
    save_dir=$download_dir
elif [[ -n ${VDL_SAVE_DIR:-} ]]; then
    save_dir=$VDL_SAVE_DIR
else
    download_base=''
    if have xdg-user-dir; then
        download_base=$(xdg-user-dir DOWNLOAD 2>/dev/null) || download_base=''
    fi
    if [[ -z $download_base || $download_base == "$HOME" ]]; then
        download_base=$HOME/Downloads
    fi
    save_dir=$download_base/vdl
fi
tmp_dir=$save_dir/.tmp
tmp_keep_days=${VDL_TMP_KEEP_DAYS:-7}
[[ $tmp_keep_days =~ ^[0-9]+$ ]] || tmp_keep_days=7
cleanup_tmp() {
    [[ -d $tmp_dir ]] || return 0
    find "$tmp_dir" -mindepth 1 -type f -mtime +"$tmp_keep_days" -delete 2>/dev/null || true
    find "$tmp_dir" -mindepth 1 -type d -empty -mtime +0 -delete 2>/dev/null || true
    rmdir "$tmp_dir" 2>/dev/null || true
}
trap cleanup_tmp EXIT

if (( audio )); then
    out_dir=$save_dir/audio
else
    out_dir=$save_dir
fi

have_aria=0
have aria2c && have_aria=1

# ---------------------------------------------------------------------------
# 5. Split URLs into direct files and media/page URLs
# ---------------------------------------------------------------------------
declare -a direct=()
declare -a media=()

for u in "${urls[@]}"; do
    path=${u,,}
    path=${path%%\?*}
    path=${path%%#*}
    if [[ $path == magnet:* ]] || [[ $path =~ \.torrent$ ]]; then
        direct+=("$u")
    elif [[ $path =~ \.(zip|rar|7z|iso|exe|msi|dmg|pkg|deb|rpm|appimage|flatpak|tar|gz|xz|zst|bz2|pdf|epub|apk|bin|img)$ ]]; then
        direct+=("$u")
    elif (( ! audio )) && [[ $path =~ \.(mp4|mkv|webm|avi|mov|flv)$ ]]; then
        direct+=("$u")
    else
        media+=("$u")
    fi
done

direct_via_ytdlp=0
if (( ${#direct[@]} )); then
    if (( ! have_aria || no_aria )); then
        direct_via_ytdlp=1
        if (( have_aria )); then
            note "--no-aria: direct files will be fetched with yt-dlp"
        else
            note "aria2c not installed: direct files will be fetched with yt-dlp"
        fi
    fi
fi

need_ytdlp=0
(( ${#media[@]} )) && need_ytdlp=1
(( direct_via_ytdlp )) && need_ytdlp=1

if (( need_ytdlp )) && ! have yt-dlp; then
    err "yt-dlp is required but was not found in PATH"
    exit 1
fi

if (( audio )) && (( ${#media[@]} )) && ! have ffmpeg; then
    err "ffmpeg is required for audio extraction (-a)"
    exit 1
fi

# ---------------------------------------------------------------------------
# 6. yt-dlp defaults (self-contained; ignores ~/.config/yt-dlp/config)
# ---------------------------------------------------------------------------
extra_conf=${VDL_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/vdl/yt-dlp.conf}

declare -a yt_common=( --ignore-config )
if [[ -f $extra_conf ]]; then
    yt_common+=( --config-locations "$extra_conf" )
fi
yt_common+=(
    --socket-timeout 15
    --retries 10
    --fragment-retries 10
    --continue
    --no-overwrites
)
(( quiet )) && yt_common+=( --quiet )
(( ! quiet )) && yt_common+=( --progress --console-title )
[[ -n $max_speed ]] && yt_common+=( --throttled-rate "$max_speed" )

impersonate=''
if (( ! no_impersonate )) && (( need_ytdlp )); then
    imp_target=${VDL_IMPERSONATE:-auto}
    if [[ $imp_target != off && $imp_target != none ]]; then
        imp_list=''
        if have yt-dlp; then
            imp_list=$(yt-dlp --ignore-config --list-impersonate-targets 2>/dev/null) || imp_list=''
        fi
        if [[ $imp_target == auto ]]; then
            for candidate in chrome firefox safari; do
                if imp_target_available "$imp_list" "$candidate"; then
                    impersonate=$candidate
                    break
                fi
            done
        elif imp_target_available "$imp_list" "$imp_target"; then
            impersonate=$imp_target
        else
            warn "yt-dlp cannot impersonate '$imp_target'; --impersonate ignored"
        fi
    fi
fi

# Header strings
if (( ${#direct[@]} )) && (( ${#media[@]} )); then
    engine="hybrid (aria2c + yt-dlp)"
elif (( ${#direct[@]} )); then
    if (( direct_via_ytdlp )); then
        engine="yt-dlp direct (native, 1 connection)"
    else
        engine="aria2c direct (16 connections)"
    fi
elif (( ${#media[@]} )); then
    if (( have_aria && ! no_aria )); then
        engine="yt-dlp + aria2c"
    else
        engine="yt-dlp native"
    fi
else
    engine="idle"
fi

if (( audio )); then
    mode="audio only (MP3 320k)"
elif (( ${#direct[@]} )) && (( ${#media[@]} == 0 )); then
    mode="direct file download"
else
    mode="video (max ${quality}p, MP4 preferred)"
fi

display_dir=$out_dir
if [[ $display_dir == "$HOME"* ]]; then
    display_dir="~${display_dir#"$HOME"}"
fi

if (( ! quiet )); then
    printf '\n%s== vdl %s%s\n' "$C_CYN" "$VDL_VERSION" "$C_OFF"
    printf '   %sEngine  :%s %s\n' "$C_GRN" "$C_OFF" "$engine"
    printf '   %sMode    :%s %s\n' "$C_CYN" "$C_OFF" "$mode"
    if (( ${#batch_files[@]} )); then
        printf '   %sBatch   :%s %s links loaded\n' "$C_YEL" "$C_OFF" "${#urls[@]}"
    fi
    if (( ${#media[@]} )) && [[ $browser != none ]]; then
        printf '   %sCookies :%s %s\n' "$C_YEL" "$C_OFF" "$browser"
    fi
    printf '   %sSave dir:%s %s\n\n' "$C_DIM" "$C_OFF" "$display_dir"
fi

mkdir -p "$save_dir" || exit 1
if (( audio )); then
    mkdir -p "$out_dir" || exit 1
fi

# --dry-run: print the resolved plan and exit without downloading.
if (( dry_run )); then
    printf '%sURLs:%s\n' "$C_GRN" "$C_OFF"
    for u in "${urls[@]}"; do
        printf '   %s\n' "$u"
    done
    printf '%sDirect:  %d  Media: %d\n' "" "${#direct[@]}" "${#media[@]}"
    printf '%sImpersonate: %s\n' "" "${impersonate:-none}"
    printf '\n%s(dry-run — nothing downloaded)%s\n' "$C_DIM" "$C_OFF"
    exit 0
fi

rc=0

# ---------------------------------------------------------------------------
# 7. Direct downloads via aria2c
# ---------------------------------------------------------------------------
if (( ${#direct[@]} )) && (( ! direct_via_ytdlp )); then
    declare -a aria_args=(
        -x 16 -s 16 -k 1M
        --continue=true
        --file-allocation=none
        -d "$save_dir"
    )
    [[ -n $ua ]] && aria_args+=( "--user-agent=$ua" )
    [[ -n $referer ]] && aria_args+=( "--referer=$referer" )
    [[ -n $proxy ]] && aria_args+=( "--all-proxy=$proxy" )
    (( quiet )) && aria_args+=( --quiet=true )
    [[ -n $max_speed ]] && aria_args+=( "--max-download-limit=$max_speed" )
    [[ -n $limit_speed ]] && aria_args+=( "--max-download-limit=$limit_speed" )
    # Parse --aria-opts as space-separated; use word splitting intentionally.
    if [[ -n $aria_opts ]]; then
        # shellcheck disable=SC2086  # explicit word splitting of user-provided opts
        aria_args+=($aria_opts)
    fi

    aria_rc=0
    aria2c "${aria_args[@]}" "${direct[@]}" || aria_rc=$?
    if (( aria_rc != 0 )); then
        warn "aria2c failed (exit $aria_rc) — retrying failed URLs via yt-dlp"
        # Fall back to yt-dlp for any direct URLs that aria2c couldn't fetch.
        direct_via_ytdlp=1
    fi
fi

# ---------------------------------------------------------------------------
# 8. Direct downloads via yt-dlp (no aria2c available, or --no-aria)
# ---------------------------------------------------------------------------
if (( direct_via_ytdlp )); then
    declare -a yt_direct=( "${yt_common[@]}" --downloader "http,https:native" )
    yt_direct+=( -P "home:$save_dir" -P "temp:$tmp_dir" )
    if [[ $browser != none ]]; then
        yt_direct+=( --cookies-from-browser "$browser" )
    fi
    [[ -n $impersonate ]] && yt_direct+=( --impersonate "$impersonate" )
    [[ -n $ua ]] && yt_direct+=( --user-agent "$ua" )
    [[ -n $referer ]] && yt_direct+=( --referer "$referer" )
    [[ -n $proxy ]] && yt_direct+=( --proxy "$proxy" )

    # yt-dlp's generic extractor calls unknown file types "unknown_video".
    # Use the URL basename so direct files keep their real name.
    for u in "${direct[@]}"; do
        name=${u%%\?*}
        name=${name%%#*}
        name=${name##*/}
        case $name in
            ''|.|..) name='%(title)s.%(ext)s' ;;
            *) name=${name//%/%%} ;;
        esac
        yt-dlp "${yt_direct[@]}" ${passthru[@]+"${passthru[@]}"} -o "$name" "$u" || rc=$?
    done
fi

# ---------------------------------------------------------------------------
# 9. Media / page downloads via yt-dlp
# ---------------------------------------------------------------------------
if (( ${#media[@]} )); then
    declare -a yt_media=( "${yt_common[@]}" )

    if (( have_aria && ! no_aria )); then
        aria_dl_args="aria2c:-x 10 -s 10 -k 1M --file-allocation=none --summary-interval=0"
        [[ -n $max_speed ]]   && aria_dl_args+=" --max-download-limit=$max_speed"
        [[ -n $limit_speed ]] && aria_dl_args+=" --max-download-limit=$limit_speed"
        (( quiet )) && aria_dl_args+=" --quiet=true"
        yt_media+=(
            --downloader "http,https:aria2c"
            --downloader-args "$aria_dl_args"
        )
    else
        yt_media+=( --downloader "http,https:native" )
    fi
    yt_media+=( --downloader "dash,m3u8:native" -N 8 )

    if [[ $browser != none ]]; then
        yt_media+=( --cookies-from-browser "$browser" )
    fi
    [[ -n $impersonate ]] && yt_media+=( --impersonate "$impersonate" )
    [[ -n $ua ]] && yt_media+=( --user-agent "$ua" )
    [[ -n $referer ]] && yt_media+=( --referer "$referer" )
    [[ -n $proxy ]] && yt_media+=( --proxy "$proxy" )

    if (( audio )); then
        yt_media+=(
            -f 'bestaudio/best'
            -x --audio-format mp3 --audio-quality 320K
            --embed-metadata --embed-thumbnail
            -P "home:$out_dir"
            -P "temp:$tmp_dir"
            --output-na-placeholder '.'
            -o '%(playlist_title)s/%(playlist_index&{} - |)s%(title).80B [%(id)s].%(ext)s'
        )
    else
        yt_media+=(
            -f "bv*[height<=${quality}]+ba/b[height<=${quality}]/b"
            -S 'ext:mp4:m4a'
            --merge-output-format mp4
            --embed-metadata
            -P "home:$save_dir"
            -P "temp:$tmp_dir"
            --output-na-placeholder '.'
            -o '%(playlist_title,album)s/%(playlist_index&{} - |)s%(title).80B [%(id)s].%(ext)s'
        )
    fi

    yt-dlp "${yt_media[@]}" ${passthru[@]+"${passthru[@]}"} "${media[@]}" || rc=$?
fi

# ---------------------------------------------------------------------------
# 10. Tidy up the temp folder (also handled by EXIT trap above)
# ---------------------------------------------------------------------------
cleanup_tmp

exit "$rc"
