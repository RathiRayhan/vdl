#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC2034  # globals declared/written here are used by lib/vdl/*.sh
# vdl - versatile downloader for Linux (yt-dlp + aria2c + gallery-dl)
#
# Requires: bash 4+, yt-dlp.
# Optional: aria2c, ffmpeg, gallery-dl (gallery/file hosts), curl_cffi
#           (browser impersonation), wl-paste / xclip / xsel (clipboard),
#           xdg-user-dir, curl (images).
#
# Direct files (.zip, .iso, .pdf, .mp4 links, ...) go to aria2c when it is
# available; pages, playlists and streams go to yt-dlp.  Known gallery/file
# hosts and --gallery go to gallery-dl when it is installed.  All yt-dlp
# defaults live in lib/vdl/ytdlp.sh, so vdl does not depend on
# ~/.config/yt-dlp/config.
#
# This file is the orchestrator; the reusable pieces live in lib/vdl/:
#   ui.sh        colors, status output, progress bar, banner/summary
#   helpers.sh   usage, parsing/normalization, config, URL classification
#   images.sh    embedded-image scanning and downloading
#   gallery.sh   gallery-dl host routing, downloads, and fallback
#   downloads.sh direct/media download engines and --dedupe
#   args.sh      command-line parsing
#   settings.sh  browser/quality/speed resolution
#   collect.sh   URL collection and validation
#   paths.sh     save dir, temp dir, traps, --output repointing
#   classify.sh  direct/media split, image scan, --name/--output resolution
#   ytdlp.sh     yt-dlp defaults and impersonation
#   plan.sh      engine/mode strings and the dry-run plan
# See docs/SPEC.md for the behavior contract these files implement.

set -u -o pipefail

readonly VDL_VERSION="2.4.0"

# Resolve the script's real location first, so a symlinked vdl on PATH can
# still find its libraries.
vdl_bin=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
vdl_lib="$(cd "$(dirname "$vdl_bin")/../lib/vdl" 2>/dev/null && pwd)"
if [[ -z $vdl_lib || ! -d $vdl_lib ]]; then
    printf 'vdl: library directory not found next to the script (expected lib/vdl/)\n' >&2
    exit 1
fi
for _lib in ui helpers images gallery downloads args settings collect paths classify ytdlp plan; do
    # shellcheck source=/dev/null  # resolved at runtime
    # shellcheck disable=SC1090
    source "$vdl_lib/$_lib.sh"
done

# 1-4. Parse, resolve settings, collect URLs, set up paths.
parse_args "$@"
resolve_settings
collect_urls
# shellcheck disable=SC2154  # dry_run is set by parse_args in lib/vdl/args.sh
(( dry_run )) || match_browser_ua
setup_paths

# 5-6. Classify, scan for images, resolve names, build yt-dlp defaults.
declare -a direct=()
declare -a media=()
declare -a gallery=()
declare -a direct_pending=()
declare -a img_urls=()
declare -a img_refs=()
declare -a img_dirs=()
declare -a scan_pages=()
declare -A scan_do=()
declare -A scan_title=()
declare -a yt_common=()
save_dir_abs=''

classify_urls
build_yt_common

# 7. Print the plan (banner, directories, --dry-run exit).
build_header
print_plan

rc=0
cf_challenge=0
direct_ok=0 direct_fail=0 media_ok=0 media_fail=0
gallery_ok=0 gallery_fail=0
img_ok=0 img_fail=0
aria_attempted=0
zip_created=''
declare -a failed_items=()
declare -a run_files=()
declare -A pre_files=()

# 8. Download: snapshot existing save_dir files (when needed), then download.
snapshot_save_dir
download_directs
ui_run_progress
download_pending_directs
ui_run_progress
download_media
ui_run_progress
download_gallery
(( ${#gallery[@]} )) && ui_run_progress
scrape_images
download_images
ui_run_progress

# 9. Dedupe, archive, summarize.
dedupe_saved
archive_run
print_summary
if (( cf_challenge )); then
    note "A 403 challenge was detected — if the site uses Cloudflare, open the page in your browser once to solve it, then rerun: vdl reuses the browser's session cookies."
fi

# Ensure nonzero exit when any download failed, even if rc was not set
# by every failure path (e.g. magnet failures followed by HTTP success).
if (( direct_fail + media_fail + gallery_fail + img_fail > 0 )); then
    (( rc != 0 )) || rc=1
fi

trap - EXIT
cleanup_tmp

exit "$rc"
