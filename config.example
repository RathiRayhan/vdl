# vdl example configuration.
# Copy to ~/.config/vdl/config (or $VDL_CONFIG_DIR/config) and adjust.
# Precedence: command-line flags > VDL_* environment variables > this file > built-ins.

BROWSER=vivaldi
QUALITY=1080
SAVE_DIR=~/Downloads/vdl
# GALLERY=1        # same as --gallery (all non-direct URLs via gallery-dl)
# IMAGES=1         # scan generic album pages for embedded images
